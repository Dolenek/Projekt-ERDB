# EpicRPGBotCSharp environment configuration
# Copy this file to `.env` and fill the values as needed.

BASE_URL=https://discord.com
DISCORD_CHANNEL_URL=http://discord.com/channels/0000000000000000000/0000000000000000000
AREA=10
DISCORD_EMAIL=
DISCORD_PASSWORD=
#Found in chrome://version
SOURCE_USER_DATA_DIR="C:\Users\YOUR_USER\AppData\Local\Google\Chrome\User Data"
PROFILE_NAME="Profile 1"

# Local puzzle solver (no remote API key required)
PUZZLE_ITEM_NAMES_FILE=items.json
PUZZLE_TEMPLATES_DIR=models/puzzle/production/Items
PUZZLE_LOCAL_POLICY_FILE=models/puzzle/production/policy.json
PUZZLE_AUTO_SEND=1
PUZZLE_DEBUG_CAPTURE=0
PUZZLE_DEBUG_DIR=artifacts/puzzle-debug
PUZZLE_SELFTEST=0
PUZZLE_SELFTEST_REPLAY_DIR=
