<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="EpicRPGBot.UI.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Settings"
        Icon="/EpicRPGBot.UI;component/Assets/icon.png"
        Width="900"
        Height="680"
        MinWidth="720"
        MinHeight="520"
        Background="#081119"
        Foreground="#F4F7FA"
        WindowStartupLocation="CenterOwner"
        Loaded="SettingsWindow_Loaded"
        SourceInitialized="SettingsWindow_SourceInitialized"
        StateChanged="SettingsWindow_StateChanged"
        WindowStyle="None"
        ResizeMode="CanResize"
        UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="78"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/SettingsDialogTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource TopBarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Settings" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="Discord connection and automation defaults"
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource SuccessDarkBrush}"
                        BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="9,3" Margin="0,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="AUTO-SAVE" Foreground="{StaticResource SuccessBrush}"
                               FontSize="11" FontWeight="SemiBold"/>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="SettingsMinimizeBtn" Content="&#xE921;"
                            Style="{StaticResource WindowControlButtonStyle}"
                            Click="SettingsMinimizeBtn_Click"/>
                    <Button x:Name="SettingsMaximizeRestoreBtn" Content="&#xE922;"
                            Style="{StaticResource WindowControlButtonStyle}"
                            Click="SettingsMaximizeRestoreBtn_Click"/>
                    <Button x:Name="SettingsCloseWindowBtn" Content="&#xE8BB;"
                            Style="{StaticResource CloseWindowButtonStyle}"
                            Click="SettingsCloseWindowBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="20,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="9*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="11*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Discord" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="Shared persistent WebView2 destination channels."
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap" Margin="0,3,0,14"/>
                            <TextBlock Text="Channel URL" Style="{StaticResource SettingsFieldLabelStyle}"/>
                            <TextBox x:Name="ChannelUrlBox" Margin="0,0,0,12"/>
                            <TextBlock Text="Dungeon listing channel URL" Style="{StaticResource SettingsFieldLabelStyle}"/>
                            <TextBox x:Name="DungeonListingChannelUrlBox" Margin="0,0,0,12"/>
                            <CheckBox x:Name="UseAtMeFallback" Content="Fallback to @me if a channel is empty"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Advanced tools" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="Open focused configuration dialogs."
                                       Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,12"/>
                            <Button x:Name="WorkCommandsBtn" Content="Work commands"
                                    Style="{StaticResource SettingsActionButtonStyle}" Margin="0,0,0,7"
                                    Click="WorkCommandsBtn_Click"/>
                            <Button x:Name="GuildRaidBtn" Content="Guild raid"
                                    Style="{StaticResource SettingsActionButtonStyle}" Margin="0,0,0,7"
                                    Click="GuildRaidBtn_Click"/>
                            <Button x:Name="CardHandBtn" Content="Card hand"
                                    Style="{StaticResource SettingsActionButtonStyle}" Click="CardHandBtn_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Column="2" Style="{StaticResource SettingsCardStyle}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Bot parameters" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Timing values are stored in milliseconds."
                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,14"/>
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,7,10">
                                <TextBlock Text="Area" Style="{StaticResource SettingsFieldLabelStyle}"/>
                                <TextBox x:Name="AreaBox"/>
                            </StackPanel>
                            <StackPanel Margin="7,0,0,10">
                                <TextBlock Text="Hunt cooldown" Style="{StaticResource SettingsFieldLabelStyle}"/>
                                <TextBox x:Name="HuntCdBox"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,7,10">
                                <TextBlock Text="Adventure cooldown" Style="{StaticResource SettingsFieldLabelStyle}"/>
                                <TextBox x:Name="AdventureCdBox"/>
                            </StackPanel>
                            <StackPanel Margin="7,0,0,10">
                                <TextBlock Text="Training cooldown" Style="{StaticResource SettingsFieldLabelStyle}"/>
                                <TextBox x:Name="TrainingCdBox"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,7,10">
                                <TextBlock Text="Work cooldown" Style="{StaticResource SettingsFieldLabelStyle}"/>
                                <TextBox x:Name="WorkCdBox"/>
                            </StackPanel>
                            <StackPanel Margin="7,0,0,10">
                                <TextBlock Text="Farm cooldown" Style="{StaticResource SettingsFieldLabelStyle}"/>
                                <TextBox x:Name="FarmCdBox"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,7,10">
                                <TextBlock Text="Lootbox cooldown" Style="{StaticResource SettingsFieldLabelStyle}"/>
                                <TextBox x:Name="LootboxCdBox"/>
                            </StackPanel>
                        </UniformGrid>
                        <Separator Background="{StaticResource BorderBrush}" Margin="0,2,0,12"/>
                        <CheckBox x:Name="AscendedCheckBox"
                                  Content="Ascended — allow farm below area 4" Margin="0,0,0,11"/>
                        <CheckBox x:Name="AutoDeleteDungeonChannelCheckBox"
                                  Content="Automatically delete the dungeon channel after a win"
                                  Margin="0,0,0,11"/>
                        <CheckBox x:Name="BringGuardAlertsToForegroundCheckBox"
                                  Content="Bring the EPIC GUARD tab and app to the foreground"/>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource TopBarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,11">
            <Grid>
                <TextBlock Text="Changes are applied immediately."
                           Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                <Button x:Name="CloseBtn" Content="Close" Style="{StaticResource BaseButtonStyle}"
                        Width="92" HorizontalAlignment="Right" Click="CloseBtn_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
