<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="EpicRPGBot.UI.Settings.WorkCommandsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Work Commands"
        Icon="/EpicRPGBot.UI;component/Assets/icon.png"
        Width="720" Height="650"
        MinWidth="560" MinHeight="460"
        Background="#081119" Foreground="#F4F7FA"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="78" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/SettingsDialogTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource TopBarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="22,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Work Commands" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="Commands used for work areas 1–15"
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource SuccessDarkBrush}"
                        BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="9,3" Margin="0,0,10,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="AUTO-SAVE" Foreground="{StaticResource SuccessBrush}"
                               FontSize="11" FontWeight="SemiBold"/>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeBtn" Content="&#xE921;"
                            Style="{StaticResource WindowControlButtonStyle}"/>
                    <Button x:Name="MaximizeRestoreBtn" Content="&#xE922;"
                            Style="{StaticResource WindowControlButtonStyle}"/>
                    <Button x:Name="CloseWindowBtn" Content="&#xE8BB;"
                            Style="{StaticResource CloseWindowButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="20,18">
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Area commands" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="Each command is normalized when its field loses focus."
                                       Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button x:Name="AutoBestBtn" Grid.Column="1" Content="Auto-Best"
                                Style="{StaticResource BaseButtonStyle}" MinWidth="116"
                                VerticalAlignment="Center" Click="AutoBestBtn_Click"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <ProgressBar x:Name="AutoBestProgress" Width="80" Height="5"
                                     Margin="0,0,10,0" VerticalAlignment="Center"
                                     IsIndeterminate="True" Visibility="Collapsed"/>
                        <TextBlock x:Name="AutoBestStatusText"
                                   Text="Loads profile data and replaces all area commands."
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,14,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Area, StringFormat=Area {0}}"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                    <TextBox Grid.Column="1"
                                             Text="{Binding CommandText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Tag="{Binding Area}"
                                             Loaded="AreaCommandInput_Loaded"
                                             LostFocus="AreaCommandInput_LostFocus"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource TopBarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="20,12">
            <Grid>
                <TextBlock Text="Changes are applied immediately."
                           Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                <Button x:Name="CloseBtn" Content="Close"
                        Style="{StaticResource SettingsFooterButtonStyle}"
                        HorizontalAlignment="Right" Click="CloseBtn_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
