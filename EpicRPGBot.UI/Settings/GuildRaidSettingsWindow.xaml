<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="EpicRPGBot.UI.Settings.GuildRaidSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Guild raid settings"
        Icon="/EpicRPGBot.UI;component/Assets/icon.png"
        Width="680" Height="540"
        MinWidth="540" MinHeight="430"
        Background="#081119" Foreground="#F4F7FA"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="78" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/SettingsDialogTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource TopBarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="22,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Guild Raid" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="Message watcher and matching rules"
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource SuccessDarkBrush}"
                        BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="9,3" Margin="0,0,10,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="AUTO-SAVE" Foreground="{StaticResource SuccessBrush}"
                               FontSize="11" FontWeight="SemiBold"/>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeBtn" Content="&#xE921;"
                            Style="{StaticResource WindowControlButtonStyle}"/>
                    <Button x:Name="MaximizeRestoreBtn" Content="&#xE922;"
                            Style="{StaticResource WindowControlButtonStyle}"/>
                    <Button x:Name="CloseWindowBtn" Content="&#xE8BB;"
                            Style="{StaticResource CloseWindowButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="20,18">
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <TextBlock Text="Watcher configuration" FontSize="16" FontWeight="SemiBold"
                               Margin="0,0,0,14"/>
                    <TextBlock Text="Channel URL" Style="{StaticResource SettingsFieldLabelStyle}"/>
                    <TextBox x:Name="GuildRaidChannelUrlBox" Margin="0,0,0,12"/>

                    <TextBlock Text="Trigger text" Style="{StaticResource SettingsFieldLabelStyle}"/>
                    <TextBox x:Name="GuildRaidTriggerTextBox" Margin="0,0,0,12"/>

                    <TextBlock Text="Match mode" Style="{StaticResource SettingsFieldLabelStyle}"/>
                    <ComboBox x:Name="GuildRaidMatchModeBox" Margin="0,0,0,12">
                        <ComboBoxItem Tag="contains" Content="Contains configured text"/>
                        <ComboBoxItem Tag="exact" Content="Exact message match"/>
                    </ComboBox>

                    <TextBlock Text="Author filter (optional)"
                               Style="{StaticResource SettingsFieldLabelStyle}"/>
                    <TextBox x:Name="GuildRaidAuthorFilterBox"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource TopBarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="20,12">
            <Grid>
                <TextBlock Text="Changes are applied immediately."
                           Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                <Button x:Name="CloseBtn" Content="Close"
                        Style="{StaticResource SettingsFooterButtonStyle}"
                        HorizontalAlignment="Right" Click="CloseBtn_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
