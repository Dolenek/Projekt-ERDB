<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="EpicRPGBot.UI.Settings.CardHandSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Card Hand Settings"
        Icon="/EpicRPGBot.UI;component/Assets/icon.png"
        Width="760" Height="600"
        MinWidth="600" MinHeight="520"
        Background="#081119" Foreground="#F4F7FA"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="78" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/SettingsDialogTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource TopBarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="22,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Card Hand" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="Deck import and expected-reward preferences"
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource SuccessDarkBrush}"
                        BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="9,3" Margin="0,0,10,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="AUTO-SAVE" Foreground="{StaticResource SuccessBrush}"
                               FontSize="11" FontWeight="SemiBold"/>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeBtn" Content="&#xE921;"
                            Style="{StaticResource WindowControlButtonStyle}"/>
                    <Button x:Name="MaximizeRestoreBtn" Content="&#xE922;"
                            Style="{StaticResource WindowControlButtonStyle}"/>
                    <Button x:Name="CloseWindowBtn" Content="&#xE8BB;"
                            Style="{StaticResource CloseWindowButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="20,18">
            <StackPanel>
                <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <CheckBox x:Name="AutoPlayCheckBox" Content="Auto Card Hand"/>
                            <TextBlock x:Name="DeckStatusText"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="LoadDeckButton" Grid.Column="1" Content="Load card deck"
                                Style="{StaticResource BaseButtonStyle}" MinWidth="140"
                                VerticalAlignment="Center" Click="LoadDeckButton_Click"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingsCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Reward weights" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Set a reward to 0 to ignore it."
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,4,0,14" TextWrapping="Wrap"/>
                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,12,12">
                                <TextBlock Text="Time capsule" Style="{StaticResource SettingsFieldLabelStyle}"/>
                                <TextBox x:Name="TimeCapsuleWeightBox"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,12">
                                <TextBlock Text="Round card" Style="{StaticResource SettingsFieldLabelStyle}"/>
                                <TextBox x:Name="RoundCardWeightBox"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="ETERNAL lootbox" Style="{StaticResource SettingsFieldLabelStyle}"/>
                                <TextBox x:Name="EternalLootboxWeightBox"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,12">
                                <TextBlock Text="GODLY lootbox" Style="{StaticResource SettingsFieldLabelStyle}"/>
                                <TextBox x:Name="GodlyLootboxWeightBox"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,12">
                                <TextBlock Text="OMEGA lootbox" Style="{StaticResource SettingsFieldLabelStyle}"/>
                                <TextBox x:Name="OmegaLootboxWeightBox"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Flask" Style="{StaticResource SettingsFieldLabelStyle}"/>
                                <TextBox x:Name="FlaskWeightBox"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Time cookie" Style="{StaticResource SettingsFieldLabelStyle}"/>
                                <TextBox x:Name="TimeCookieWeightBox"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Guild ring" Style="{StaticResource SettingsFieldLabelStyle}"/>
                                <TextBox x:Name="GuildRingWeightBox"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Arena cookie" Style="{StaticResource SettingsFieldLabelStyle}"/>
                                <TextBox x:Name="ArenaCookieWeightBox"/>
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock x:Name="ValidationText" Foreground="{StaticResource WarningBrush}"
                                   Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource TopBarBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="20,12">
            <Grid>
                <TextBlock Text="Preference changes are applied immediately."
                           Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                <Button x:Name="CloseButton" Content="Close"
                        Style="{StaticResource SettingsFooterButtonStyle}"
                        HorizontalAlignment="Right" Click="CloseButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
