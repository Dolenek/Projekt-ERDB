<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="EpicRPGBot.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:EpicRPGBot.UI.Controls"
        xmlns:models="clr-namespace:EpicRPGBot.UI.Models"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="EpicRPG Bot UI"
        Icon="/EpicRPGBot.UI;component/Assets/icon.png"
        Width="1600"
        Height="900"
        MinWidth="1200"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        SourceInitialized="MainWindow_SourceInitialized"
        StateChanged="MainWindow_StateChanged"
        Background="#081119">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/MainWindowTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource AppBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource TopBarBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="18,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,22,0">
                        <Image Source="/EpicRPGBot.UI;component/Assets/icon.png"
                               Width="34" Height="34" Margin="0,0,10,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="EPIC RPG BOT"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                        <Ellipse x:Name="ConnectionStatusDot" Style="{StaticResource StatusDotStyle}" Fill="{StaticResource WarningBrush}"/>
                        <TextBlock x:Name="ConnectionStatusText" Text="Initializing" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="EngineStatusDot" Style="{StaticResource StatusDotStyle}" Fill="{StaticResource MutedTextBrush}"/>
                        <TextBlock x:Name="EngineStatusText" Text="Stopped" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="StartBtn" Content="▶  Start" Style="{StaticResource PrimaryButtonStyle}" MinWidth="100" Click="StartBtn_Click"/>
                        <Button x:Name="StopBtn" Content="■  Stop" Style="{StaticResource DangerButtonStyle}" MinWidth="96" Margin="5,0,0,0" Click="StopBtn_Click"/>
                        <Button x:Name="ReloadBtn" Content="↻  Reload" Style="{StaticResource TitleBarButtonStyle}" Click="ReloadBtn_Click"/>
                        <Button x:Name="SettingsBtn" Content="⚙  Settings" Style="{StaticResource TitleBarButtonStyle}" Click="SettingsBtn_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Column="5"
                                Orientation="Horizontal"
                                Margin="12,0,0,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MinimizeBtn" Content="&#xE921;" Style="{StaticResource WindowControlButtonStyle}" Click="MinimizeBtn_Click"/>
                        <Button x:Name="MaximizeRestoreBtn" Content="&#xE922;" Style="{StaticResource WindowControlButtonStyle}" Click="MaximizeRestoreBtn_Click"/>
                        <Button x:Name="CloseWindowBtn" Content="&#xE8BB;" Style="{StaticResource CloseWindowButtonStyle}" Click="CloseWindowBtn_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ActivityColumn" Width="300"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="ControlCenterColumn" Width="360"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid x:Name="ActivityExpandedContent" Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="44"/>
                                <RowDefinition Height="44"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <TextBlock Text="Activity" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button x:Name="ActivityCollapseBtn" Content="‹" HorizontalAlignment="Right" Style="{StaticResource PanelToggleButtonStyle}" Click="ActivityToggleBtn_Click"/>
                            </Grid>

                            <Grid Grid.Row="1" Background="{StaticResource AppBackgroundBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="LastMessagesTabBtn" Grid.Column="0" Content="Messages" Tag="Selected" Style="{StaticResource SegmentButtonStyle}" Click="LastMessagesTabBtn_Click"/>
                                <Button x:Name="StatsTabBtn" Grid.Column="1" Content="Stats" Style="{StaticResource SegmentButtonStyle}" Click="StatsTabBtn_Click"/>
                                <Button x:Name="ConsoleTabBtn" Grid.Column="2" Content="Console" Style="{StaticResource SegmentButtonStyle}" Click="ConsoleTabBtn_Click"/>
                            </Grid>

                            <Grid x:Name="ActivityFilterPanel" Grid.Row="2" Margin="0,10,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" Margin="0,0,8,0">
                                    <TextBox x:Name="ActivitySearchBox" TextChanged="ActivitySearchBox_TextChanged"/>
                                    <TextBlock x:Name="ActivitySearchPlaceholder"
                                               Text="Filter activity..."
                                               Foreground="{StaticResource MutedTextBrush}"
                                               VerticalAlignment="Center"
                                               Margin="11,0,0,0"
                                               IsHitTestVisible="False"/>
                                </Grid>
                                <ComboBox x:Name="ActivityKindFilter" Grid.Column="1" Width="100" SelectedIndex="0" SelectionChanged="ActivityKindFilter_SelectionChanged">
                                    <ComboBoxItem Content="All"/>
                                    <ComboBoxItem Content="Info" Tag="{x:Static models:LogKind.Info}"/>
                                    <ComboBoxItem Content="Command" Tag="{x:Static models:LogKind.Command}"/>
                                    <ComboBoxItem Content="Warning" Tag="{x:Static models:LogKind.Warning}"/>
                                    <ComboBoxItem Content="Error" Tag="{x:Static models:LogKind.Error}"/>
                                    <ComboBoxItem Content="Engine" Tag="{x:Static models:LogKind.Engine}"/>
                                </ComboBox>
                            </Grid>

                            <Grid Grid.Row="3">
                                <Grid x:Name="LastMessagesPanel">
                                    <ListBox x:Name="StatsList" HorizontalContentAlignment="Stretch">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="66"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding At, StringFormat={}{0:HH:mm:ss}}" Foreground="{StaticResource MutedTextBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>

                                <Grid x:Name="StatsPanel" Visibility="Collapsed">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <TextBlock Text="Commands sent" Style="{StaticResource SectionTitleStyle}"/>
                                            <TextBlock x:Name="HuntCountText" Text="Hunt sent: 0" Margin="4"/>
                                            <TextBlock x:Name="AdventureCountText" Text="Adventure sent: 0" Margin="4"/>
                                            <TextBlock x:Name="TrainingCountText" Text="Training sent: 0" Margin="4"/>
                                            <TextBlock x:Name="WorkCountText" Text="Work sent: 0" Margin="4"/>
                                            <TextBlock x:Name="FarmCountText" Text="Farm sent: 0" Margin="4"/>
                                            <TextBlock x:Name="LootboxCountText" Text="Lootbox sent: 0" Margin="4,4,4,16"/>
                                            <TextBlock Text="Cooldown state" Style="{StaticResource SectionTitleStyle}"/>
                                            <TextBlock x:Name="RunningCooldownsText" Text="Running cooldowns: 0 / 15" Margin="4"/>
                                            <TextBlock x:Name="RunningRewardsText" Text="Rewards running: 0 / 5" Margin="4"/>
                                            <TextBlock x:Name="RunningExperienceText" Text="Experience running: 0 / 5" Margin="4"/>
                                            <TextBlock x:Name="RunningProgressText" Text="Progress running: 0 / 5" Margin="4"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>

                                <Grid x:Name="ConsolePanel" Visibility="Collapsed">
                                    <ListBox x:Name="ConsoleList" HorizontalContentAlignment="Stretch" SelectionMode="Extended" PreviewKeyDown="ConsoleList_PreviewKeyDown">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="14"/>
                                                        <ColumnDefinition Width="66"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse x:Name="LogKindDot" Width="8" Height="8" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding At, StringFormat={}{0:HH:mm:ss}}" Foreground="{StaticResource MutedTextBrush}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap"/>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:LogKind.Command}">
                                                        <Setter TargetName="LogKindDot" Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:LogKind.Warning}">
                                                        <Setter TargetName="LogKindDot" Property="Fill" Value="{StaticResource WarningBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:LogKind.Error}">
                                                        <Setter TargetName="LogKindDot" Property="Fill" Value="{StaticResource DangerBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:LogKind.Engine}">
                                                        <Setter TargetName="LogKindDot" Property="Fill" Value="{StaticResource AccentBrush}"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Grid>
                        </Grid>

                        <Grid x:Name="ActivityCollapsedContent" Visibility="Collapsed">
                            <Button x:Name="ActivityExpandBtn" Content="›" VerticalAlignment="Top" Margin="3,8" Style="{StaticResource PanelToggleButtonStyle}" Click="ActivityToggleBtn_Click"/>
                            <TextBlock Text="ACTIVITY" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.LayoutTransform>
                                    <RotateTransform Angle="-90"/>
                                </TextBlock.LayoutTransform>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Background="{StaticResource AppBackgroundBrush}">
                    <TabControl x:Name="BrowserTabs"
                                Background="{StaticResource AppBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0"
                                SelectedIndex="0">
                        <TabItem x:Name="PlayerBrowserTab" Header="Player" Style="{StaticResource BrowserTabItemStyle}">
                            <wv2:WebView2 x:Name="PlayerWeb" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </TabItem>
                        <TabItem x:Name="BotBrowserTab" Header="Bot" Style="{StaticResource BrowserTabItemStyle}">
                            <wv2:WebView2 x:Name="Web" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </TabItem>
                        <TabItem x:Name="GuildBrowserTab" Header="Guild" Style="{StaticResource BrowserTabItemStyle}">
                            <wv2:WebView2 x:Name="GuildWeb" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </TabItem>
                        <TabItem x:Name="DungeonBrowserTab" Header="Dungeon" Style="{StaticResource BrowserTabItemStyle}">
                            <wv2:WebView2 x:Name="DungeonWeb" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </TabItem>
                        <TabItem x:Name="DuelBrowserTab" Header="Duel" Style="{StaticResource BrowserTabItemStyle}">
                            <wv2:WebView2 x:Name="DuelWeb" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </TabItem>
                    </TabControl>
                    <Button x:Name="GoChannelBtn"
                            Content="Go to channel"
                            Style="{StaticResource TitleBarButtonStyle}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,8,12,0"
                            Panel.ZIndex="2"
                            Click="GoChannelBtn_Click"/>
                    <TextBlock x:Name="InitHint" Text="Loading WebView2..." Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Panel.ZIndex="3"/>
                </Grid>

                <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid x:Name="ControlCenterExpandedContent" Margin="10,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <TextBlock Text="Control Center" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button x:Name="ControlCenterCollapseBtn" Content="›" HorizontalAlignment="Right" Style="{StaticResource PanelToggleButtonStyle}" Click="ControlCenterToggleBtn_Click"/>
                            </Grid>

                            <Grid Grid.Row="1">
                                <StackPanel>
                                    <TextBlock Text="Quick actions" Style="{StaticResource ControlSectionTitleStyle}"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="InitBtn" Grid.Column="0" Content="Initialize" Style="{StaticResource ActionButtonStyle}" Margin="0,0,2,0" Click="InitBtn_Click"/>
                                        <Button x:Name="RpgCdBtn" Grid.Column="1" Content="Cooldowns" Style="{StaticResource ActionButtonStyle}" Margin="2,0" Click="RpgCdBtn_Click"/>
                                        <Button x:Name="TradeAreaBtn" Grid.Column="2" Content="Trade area" Style="{StaticResource ActionButtonStyle}" Margin="2,0" Click="TradeAreaBtn_Click"/>
                                        <Button x:Name="WishingTokenBtn" Grid.Column="3" Content="Wishing token" Style="{StaticResource ActionButtonStyle}" Margin="2,0,0,0" Click="WishingTokenBtn_Click"/>
                                    </Grid>

                                    <TextBlock Text="Inventory tools" Style="{StaticResource ControlSectionTitleStyle}"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="CraftingBtn" Grid.Column="0" Content="Crafting" Style="{StaticResource ActionButtonStyle}" Margin="0,0,2,0" Click="CraftingBtn_Click"/>
                                        <Button x:Name="DismantleBtn" Grid.Column="1" Content="Dismantle" Style="{StaticResource ActionButtonStyle}" Margin="2,0,0,0" Click="DismantleBtn_Click"/>
                                    </Grid>

                                    <Button x:Name="PetsBtn" Content="Pets" Style="{StaticResource ActionButtonStyle}" Click="PetsBtn_Click" AutomationProperties.AutomationId="PetsButton" Margin="0,4,0,0"/>
                                    <TextBlock Text="Runs" Style="{StaticResource ControlSectionTitleStyle}"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="CompleteDungeonBtn" Grid.Column="0" Content="Complete dungeon" Style="{StaticResource ActionButtonStyle}" Margin="0,0,2,0" Click="CompleteDungeonBtn_Click"/>
                                        <Button x:Name="DuelBtn" Grid.Column="1" Content="Start duel" Style="{StaticResource ActionButtonStyle}" Margin="2,0,0,0" Click="DuelBtn_Click"/>
                                    </Grid>

                                    <TextBlock Text="Time cookie" Style="{StaticResource ControlSectionTitleStyle}"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="TimeCookieDungeonBtn" Grid.Column="0" Content="Dungeon" Style="{StaticResource ActionButtonStyle}" Margin="0,0,2,0" Click="TimeCookieDungeonBtn_Click"/>
                                        <Button x:Name="TimeCookieDuelBtn" Grid.Column="1" Content="Duel" Style="{StaticResource ActionButtonStyle}" Margin="2,0" Click="TimeCookieDuelBtn_Click"/>
                                        <Button x:Name="TimeCookieCardHandBtn" Grid.Column="2" Content="Card hand" Style="{StaticResource ActionButtonStyle}" Margin="2,0" Click="TimeCookieCardHandBtn_Click"/>
                                        <Button x:Name="SleepyPotionBtn" Grid.Column="3" Content="Sleepy potion" Style="{StaticResource ActionButtonStyle}" Margin="2,0,0,0" Click="SleepyPotionBtn_Click"/>
                                    </Grid>

                                    <controls:CooldownPanelControl x:Name="CooldownVisual"/>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <Grid x:Name="ControlCenterCollapsedContent" Visibility="Collapsed">
                            <Button x:Name="ControlCenterExpandBtn" Content="‹" VerticalAlignment="Top" Margin="3,8" Style="{StaticResource PanelToggleButtonStyle}" Click="ControlCenterToggleBtn_Click"/>
                            <TextBlock Text="CONTROLS" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.LayoutTransform>
                                    <RotateTransform Angle="90"/>
                                </TextBlock.LayoutTransform>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
