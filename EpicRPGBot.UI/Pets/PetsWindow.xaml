<Window x:Class="EpicRPGBot.UI.Pets.PetsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Pets" Width="1120" Height="820" MinWidth="880" MinHeight="650"
 Background="#1e1f22" Foreground="#ddd" WindowStartupLocation="CenterOwner">
 <Window.Resources>
  <ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/MainWindowTheme.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="10,6"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#ddd"/><Setter Property="Margin" Value="6"/></Style>
  <Style TargetType="TextBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="5"/><Setter Property="Background" Value="#242529"/><Setter Property="Foreground" Value="#ddd"/><Setter Property="BorderBrush" Value="#45474d"/></Style>
  <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontSize" Value="13"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#303238"/><Setter Property="Foreground" Value="#ddd"/><Setter Property="Padding" Value="8"/></Style>
  <Style TargetType="DataGridRow"><Setter Property="Background" Value="#242529"/><Setter Property="Foreground" Value="#ddd"/><Setter Property="MinHeight" Value="28"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="4"/><Setter Property="BorderThickness" Value="0"/></Style>
  </ResourceDictionary>
 </Window.Resources>
 <Grid Margin="16" Background="#1e1f22">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
   <RowDefinition Height="110"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <DockPanel><TextBlock Text="Pets" FontSize="24" FontWeight="SemiBold"/>
   <TextBlock x:Name="CountText" Margin="18,0"/>
   <Button x:Name="RefreshButton" Content="Refresh pets" Click="Refresh_Click" HorizontalAlignment="Right"/></DockPanel>
  <WrapPanel Grid.Row="1" x:Name="Filters">
   <TextBlock Text="Search"/><TextBox x:Name="SearchBox" Width="160" TextChanged="Filter_Changed"/>
   <TextBlock Text="Species"/><TextBox x:Name="SpeciesBox" Width="110" TextChanged="Filter_Changed"/>
   <TextBlock Text="Tier"/><TextBox x:Name="TierFilterBox" Width="55" TextChanged="Filter_Changed"/>
   <TextBlock Text="Skill"/><TextBox x:Name="SkillBox" Width="110" TextChanged="Filter_Changed"/>
   <Button x:Name="SelectButton" Content="Select all unprotected" Click="Select_Click"/>
   <Button x:Name="ResetButton" Content="Reset selections and locks" Click="Reset_Click"/>
  </WrapPanel>
  <DataGrid Grid.Row="2" x:Name="PetGrid" AutoGenerateColumns="False" CanUserAddRows="False"
   CanUserDeleteRows="False" Background="#242529" Foreground="#ddd" SelectionMode="Single" GridLinesVisibility="Horizontal"
   HorizontalGridLinesBrush="#35373b" HeadersVisibility="Column">
   <DataGrid.Columns>
    <DataGridCheckBoxColumn Header="Material" Width="75" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}"/>
    <DataGridCheckBoxColumn Header="Lock" Width="50" Binding="{Binding Locked, UpdateSourceTrigger=PropertyChanged}"/>
    <DataGridTextColumn Header="ID" Width="45" Binding="{Binding Id}" IsReadOnly="True"/>
    <DataGridTextColumn Header="Species" Width="95" Binding="{Binding Species}" IsReadOnly="True"/>
    <DataGridTextColumn Header="Tier" Width="45" Binding="{Binding Tier}" IsReadOnly="True"/>
    <DataGridTextColumn Header="Score" Width="65" Binding="{Binding Score}" IsReadOnly="True"/>
    <DataGridTextColumn Header="Status" Width="65" Binding="{Binding Status}" IsReadOnly="True"/>
    <DataGridTextColumn Header="Skills" Binding="{Binding Skills}" Width="*" MinWidth="210" IsReadOnly="True">
     <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ToolTip" Value="{Binding Skills}"/></Style></DataGridTextColumn.ElementStyle>
    </DataGridTextColumn>
    <DataGridTextColumn Header="Protection" Binding="{Binding Protection}" Width="210" MinWidth="210" IsReadOnly="True"/>
   </DataGrid.Columns>
  </DataGrid>
  <WrapPanel Grid.Row="3" x:Name="ProtectionPanel" Margin="0,8">
   <CheckBox x:Name="KeepBestBox" Content="Keep best of each species" Click="Options_Changed"/>
   <CheckBox x:Name="SpecialBox" Content="Protect special species" Click="Options_Changed"/>
   <CheckBox x:Name="EpicBox" Content="EPIC" Click="Options_Changed"/>
   <CheckBox x:Name="AscendedBox" Content="ASCENDED" Click="Options_Changed"/>
   <CheckBox x:Name="PerfectBox" Content="PERFECT" Click="Options_Changed"/>
   <CheckBox x:Name="MixBox" Content="Allow species mixing (auto preserves target species)" Click="Options_Changed"/>
  </WrapPanel>
  <WrapPanel Grid.Row="4" x:Name="PlanPanel">
   <ComboBox x:Name="ModeBox" Width="190" SelectedIndex="2" SelectionChanged="Plan_Changed" Margin="4">
    <ComboBoxItem Content="Manual fusion (one group)"/><ComboBoxItem Content="Upgrade target"/><ComboBoxItem Content="Auto merge material"/>
   </ComboBox>
   <TextBlock Text="Target ID"/><ComboBox x:Name="TargetBox" Width="75" Margin="4" SelectionChanged="Plan_Changed"/>
   <TextBlock Text="Goal tier / count"/><TextBox x:Name="GoalBox" Width="55" Text="2" TextChanged="Filter_Changed"/>
   <TextBlock Text="TT"/><TextBox x:Name="TtBox" Width="65" TextChanged="Filter_Changed"/>
   <TextBlock Text="Strategy: TT recommended pairs" Foreground="#aaa" Margin="10,0"/>
  </WrapPanel>
  <ScrollViewer Grid.Row="5" MaxHeight="112" VerticalScrollBarVisibility="Auto">
   <TextBlock x:Name="PreviewText" TextWrapping="Wrap" Margin="4,8"/>
  </ScrollViewer>
  <TextBox Grid.Row="6" x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
   Background="#161719" Foreground="#ddd"/>
  <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button x:Name="StartButton" Content="Start fusion" Click="Start_Click" IsEnabled="False"/>
   <Button x:Name="StopButton" Content="Stop" Click="Stop_Click" IsEnabled="False"/>
   <Button x:Name="CloseButton" Content="Close" Click="Close_Click"/>
  </StackPanel>
 </Grid>
</Window>
