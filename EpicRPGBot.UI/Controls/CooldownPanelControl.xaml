<UserControl x:Class="EpicRPGBot.UI.Controls.CooldownPanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="500"
             d:DesignWidth="280">
    <UserControl.Resources>
        <Style x:Key="CooldownRowBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#22313D"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="3,1"/>
        </Style>
        <Style x:Key="CooldownValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#96A5B3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="READY">
                    <Setter Property="Background" Value="#38E879"/>
                    <Setter Property="Foreground" Value="#07120C"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="6,0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CooldownGroupStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#96A5B3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,2,0,1"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
            <Separator Background="#2f3136" Margin="0,0,0,3"/>
            <TextBlock Text="Cooldowns" Foreground="#F4F7FA" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,2"/>
            <StackPanel x:Name="CooldownsPanel" TextElement.FontSize="12">
                <TextBlock Text="Rewards" Style="{StaticResource CooldownGroupStyle}"/>

                <Border x:Name="DailyCdRow" Style="{StaticResource CooldownRowBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="daily" Foreground="#ddd"/>
                        <TextBlock x:Name="DailyCdText" Grid.Column="1" Text="READY" Style="{StaticResource CooldownValueStyle}"/>
                    </Grid>
                </Border>

                <Border x:Name="WeeklyCdRow" Style="{StaticResource CooldownRowBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="weekly" Foreground="#ddd"/>
                        <TextBlock x:Name="WeeklyCdText" Grid.Column="1" Text="READY" Style="{StaticResource CooldownValueStyle}"/>
                    </Grid>
                </Border>

                <Border x:Name="LootboxCdRow" Style="{StaticResource CooldownRowBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="lootbox" Foreground="#ddd"/>
                        <TextBlock x:Name="LootboxCdText" Grid.Column="1" Text="READY" Style="{StaticResource CooldownValueStyle}"/>
                    </Grid>
                </Border>

                <Border x:Name="CardHandCdRow" Style="{StaticResource CooldownRowBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="card hand" Foreground="#ddd"/>
                        <TextBlock x:Name="CardHandCdText" Grid.Column="1" Text="READY" Style="{StaticResource CooldownValueStyle}"/>
                    </Grid>
                </Border>

                <Border x:Name="VoteCdRow" Style="{StaticResource CooldownRowBorderStyle}" Margin="0,0,0,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="vote" Foreground="#ddd"/>
                        <TextBlock x:Name="VoteCdText" Grid.Column="1" Text="READY" Style="{StaticResource CooldownValueStyle}"/>
                    </Grid>
                </Border>

                <TextBlock Text="Experience" Style="{StaticResource CooldownGroupStyle}"/>

                <Border x:Name="HuntCdRow" Style="{StaticResource CooldownRowBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="hunt" Foreground="#ddd"/>
                        <TextBlock x:Name="HuntCdText" Grid.Column="1" Text="READY" Style="{StaticResource CooldownValueStyle}"/>
                    </Grid>
                </Border>

                <Border x:Name="AdventureCdRow" Style="{StaticResource CooldownRowBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="adventure" Foreground="#ddd"/>
                        <TextBlock x:Name="AdventureCdText" Grid.Column="1" Text="READY" Style="{StaticResource CooldownValueStyle}"/>
                    </Grid>
                </Border>

                <Border x:Name="TrainingCdRow" Style="{StaticResource CooldownRowBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="training" Foreground="#ddd"/>
                        <TextBlock x:Name="TrainingCdText" Grid.Column="1" Text="READY" Style="{StaticResource CooldownValueStyle}"/>
                    </Grid>
                </Border>

                <Border x:Name="DuelCdRow" Style="{StaticResource CooldownRowBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="duel" Foreground="#ddd"/>
                        <TextBlock x:Name="DuelCdText" Grid.Column="1" Text="READY" Style="{StaticResource CooldownValueStyle}"/>
                    </Grid>
                </Border>

                <Border x:Name="QuestCdRow" Style="{StaticResource CooldownRowBorderStyle}" Margin="0,0,0,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="quest | epic quest" Foreground="#ddd"/>
                        <TextBlock x:Name="QuestCdText" Grid.Column="1" Text="READY" Style="{StaticResource CooldownValueStyle}"/>
                    </Grid>
                </Border>

                <TextBlock Text="Progress" Style="{StaticResource CooldownGroupStyle}"/>

                <Border x:Name="WorkCdRow" Style="{StaticResource CooldownRowBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="chop | fish | pickup | mine" Foreground="#ddd"/>
                        <TextBlock x:Name="WorkCdText" Grid.Column="1" Text="READY" Style="{StaticResource CooldownValueStyle}"/>
                    </Grid>
                </Border>

                <Border x:Name="FarmCdRow" Style="{StaticResource CooldownRowBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="farm" Foreground="#ddd"/>
                        <TextBlock x:Name="FarmCdText" Grid.Column="1" Text="READY" Style="{StaticResource CooldownValueStyle}"/>
                    </Grid>
                </Border>

                <Border x:Name="HorseCdRow" Style="{StaticResource CooldownRowBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="horse breeding | horse race" Foreground="#ddd"/>
                        <TextBlock x:Name="HorseCdText" Grid.Column="1" Text="READY" Style="{StaticResource CooldownValueStyle}"/>
                    </Grid>
                </Border>

                <Border x:Name="ArenaCdRow" Style="{StaticResource CooldownRowBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="arena" Foreground="#ddd"/>
                        <TextBlock x:Name="ArenaCdText" Grid.Column="1" Text="READY" Style="{StaticResource CooldownValueStyle}"/>
                    </Grid>
                </Border>

                <Border x:Name="DungeonCdRow" Style="{StaticResource CooldownRowBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="dungeon | miniboss" Foreground="#ddd"/>
                        <TextBlock x:Name="DungeonCdText" Grid.Column="1" Text="READY" Style="{StaticResource CooldownValueStyle}"/>
                    </Grid>
                </Border>
            </StackPanel>
    </StackPanel>
</UserControl>
